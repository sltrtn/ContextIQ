# ContextIQ Backend — Environment Variables
# Copy this to .env and fill in your keys.
# Never commit .env to version control.

# --- Embedding Provider ---
# "fastembed" = local ONNX (BAAI/bge-small-en-v1.5, 384 dims) — zero API cost
# "openai"    = OpenAI text-embedding-3-small (1536 dims) — requires billing
EMBEDDING_PROVIDER=fastembed

# --- LLM Provider ---
# "groq"   = free hosted LLM via Groq API (get key at console.groq.com)
# "openai" = OpenAI GPT-4o-mini — requires billing
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# --- OpenAI (optional when using groq + fastembed, needed for evaluation with OpenAI embeddings) ---
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# --- Cohere (required for Cohere Rerank) ---
COHERE_API_KEY=your-cohere-key-here

# --- Qdrant ---
# In-memory (no setup, data lost on restart): :memory:
# Local Docker:  http://localhost:6333 (no key)
# Cloud Qdrant:  https://your-cluster-url.cloud.qdrant.io (set QDRANT_API_KEY too)
QDRANT_URL=:memory:
QDRANT_API_KEY=

# --- Celery / Redis (optional, needed for async ingestion) ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
